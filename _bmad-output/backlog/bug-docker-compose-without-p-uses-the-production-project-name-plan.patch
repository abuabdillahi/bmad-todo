 #   docker compose -p todo-test --profile test up -d --build --wait
 #   docker compose -p todo --profile prod up -d --wait               # the deploy runs this (AD-18)
 
+# The project a command uses when it passes no -p and COMPOSE_PROJECT_NAME is unset. Without
+# it Compose takes the folder's name, and a checkout (or the host's ~/todo) named `todo` would
+# land on production. -p always wins over it.
+name: todo-dev
+
 # Every service logs to stdout through json-file, rotated so logs can't fill the disk (AD-17).
 x-logging: &logging
   driver: json-file
