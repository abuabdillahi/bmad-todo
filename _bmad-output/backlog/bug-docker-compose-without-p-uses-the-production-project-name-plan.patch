new file mode 100644
index 0000000..c2a31ae
--- /dev/null
+++ b/apps/api/test/profile/project-name.profile.test.ts
@@ -0,0 +1,54 @@
+import { execFileSync } from 'node:child_process';
+import { copyFileSync, mkdirSync, mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+/**
+ * C7, AD-16: a compose command with no project name never uses production's
+ * project `todo`, and each environment's -p still wins. Reads the resolved name
+ * with the read-only `docker compose config`, from a folder named `todo` as a
+ * checkout or the host's ~/todo would be. It starts no containers.
+ */
+
+const composeFile = fileURLToPath(new URL('../../../../compose.yml', import.meta.url));
+const scratch = mkdtempSync(join(tmpdir(), 'compose-project-name-'));
+const checkout = join(scratch, 'todo');
+
+/** The environment without anything that would pick the project or the file for Compose. */
+const { COMPOSE_PROJECT_NAME: _name, COMPOSE_FILE: _file, ...env } = process.env;
+
+function projectName(...args: string[]): string {
+  const json = execFileSync('docker', ['compose', ...args, 'config', '--format', 'json'], {
+    cwd: checkout,
+    env,
+    encoding: 'utf8',
+    maxBuffer: 16 * 1024 * 1024,
+  });
+  return (JSON.parse(json) as { name: string }).name;
+}
+
+beforeAll(() => {
+  mkdirSync(checkout);
+  copyFileSync(composeFile, join(checkout, 'compose.yml'));
+});
+
+afterAll(() => {
+  rmSync(scratch, { recursive: true, force: true });
+});
+
+describe('profile: compose project name', () => {
+  it('a command with no -p in a folder named todo uses todo-dev, never production', () => {
+    const name = projectName();
+    expect(name).not.toBe('todo');
+    expect(name).toBe('todo-dev');
+  });
+
+  it.each([
+    ['todo-dev', 'dev'],
+    ['todo-test', 'test'],
+    ['todo', 'prod'],
+  ])('-p %s --profile %s uses exactly that project', (project, profile) => {
+    expect(projectName('-p', project, '--profile', profile)).toBe(project);
+  });
+});
