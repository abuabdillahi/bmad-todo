# Every variable the system reads (AD-16). Copy to .env for local overrides.
# Never put secret values in this file.
#
# Each environment runs under its own project name:
#   dev   docker compose -p todo-dev --profile dev up -d --build --wait   (http://127.0.0.1:5173)
#   test  docker compose -p todo-test --profile test up -d --build --wait (or `pnpm test:all`)
#   prod  docker compose -p todo --profile prod up -d --wait              (run by the deploy)

# development | test | production. Required: the API refuses to start when it is unset or any
# other value. No behaviour depends on it in v1.
# todo-dev: development (fixed in compose.yml); todo-test: test (set by `pnpm test:all`);
# todo: production (compose.yml's default).
APP_ENV=test
# The API's listen port. compose.yml fixes it at 3000, where nginx proxies.
PORT=3000
# The API's SQLite file, on the api-only `data` volume (AD-2). Fixed in compose.yml.
DATABASE_PATH=/data/todos.db
# fatal | error | warn | info | debug | trace | silent. When unset, todo-dev uses debug and the
# other projects use info; a value set here applies to todo-dev too.
LOG_LEVEL=info
# Image tag for ghcr.io/abuabdillahi/bmad-todo-{api,web,web-dev}. Defaults to `local`.
IMAGE_TAG=local
# Host port for web-test in the `test` profile, bound to 127.0.0.1.
TEST_WEB_PORT=8081
# Origin the contract and e2e suites reach the stack through (web-test).
E2E_BASE_URL=http://127.0.0.1:8081
# Compose project and profile the stack is inspected in. Only the `profile` test project reads them.
COMPOSE_PROJECT=todo-test
COMPOSE_PROFILE=test
# Cloudflare Tunnel token for cloudflared in the `prod` profile (AD-3). Secret: never set it here.
# On the host, each deploy writes it into .env from the GitHub secret of the same name.
TUNNEL_TOKEN=

# CI only, not read by the app (AD-18, AD-19). Set them in GitHub, never in a file:
#   secrets   DEPLOY_SSH_KEY      private key of the host's deploy user
#             DEPLOY_KNOWN_HOSTS  the host's known_hosts line(s), for strict host-key checking
#             DEPLOY_HOST         the Hetzner host's address
#             DEPLOY_USER         the deploy user on that host
#             TUNNEL_TOKEN        the Cloudflare Tunnel token above
#   variable  PUBLIC_HOSTNAME     the tunnel's public hostname, for the post-deploy health check
